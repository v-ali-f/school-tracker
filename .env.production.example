FLASK_ENV=production
SESSION_COOKIE_SECURE=1

SECRET_KEY=replace-with-long-random-secret
DATABASE_URL=postgresql+psycopg2://school_user:strong_password@127.0.0.1:5432/school_portal
UPLOAD_FOLDER=/srv/school-tracker/uploads
APP_BASE_URL=https://portal.example.ru

FIREBASE_SERVICE_ACCOUNT_FILE=/srv/school-tracker/secrets/firebase-service-account.json
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=portal.example.ru
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MEASUREMENT_ID=
FIREBASE_WEB_VAPID_KEY=
PWA_BADGE_POLL_INTERVAL_MS=60000

SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=1
SMTP_USE_TLS=0
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

MAX_BOT_TOKEN=
MAX_BOT_NAME=
MAX_API_BASE=https://platform-api.max.ru
# Workload and tariffication rollout. Keep disabled until the corresponding
# release stage has passed UAT and production approval.
AUTO_SCHEMA_BOOTSTRAP=0
FEATURE_WORKLOAD_MODULE_ENABLED=0
FEATURE_WORKLOAD_WRITE_ENABLED=0
FEATURE_WORKLOAD_NEW_SOURCE_ENABLED=0
